.\" Manpage for mv2md5 by nobody <nobody>

.TH "mv2sha256" "1" "2022-22-06" "nobody" "XDG Storage"

.SH NAME

mv2sha256 - Dateien nach SHA256 umbenennen

.SH SYNOPSIS

mv2sha265 path/to/file…

.SH DESCRIPTION

Dateien nach SHA256 umbenennen.

.SH OPTIONS

.SS -h, --help

Shows help options.

.SS -s integer, --suffix=integer

Es trennen --suffix <integer> dots den suffix vom Dateinamen.

	--suffix=last Letzter dot trennt den suffix

	--suffix=first Erster dot trennt den suffix (default)

.SH SEE ALSO

.BR xdg-storage (1)

