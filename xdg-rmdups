#!/usr/bin/env bash
# Entferne (verschieben/löschen) doppelte Dateien aus dem Storage

set -xeuo pipefail

# Die xdg-user-dirs Definitionen einlesen
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
if [[ -f "$XDG_CONFIG_HOME/user-dirs.dirs" ]]; then
	. "$XDG_CONFIG_HOME/user-dirs.dirs"
fi

# Optionen einlesen
config="${XDG_CONFIG_HOME:-$HOME/.config}/xdg-storage/config"
mkdir -p "`dirname "$config"`"; touch "$config"; . "$config"
# Standardwerte für nicht gesetzte Optionen setzen
threads_num="${threads_num:-8}"
XDG_STORAGE_DIR="${XDG_STORAGE_DIR:-$HOME/Storage}"

TEMP=$(getopt -o 'd:b:' --long 'directory:,backup:' -n "$0" -- "$@")

if [ $? -ne 0 ]; then
	usage
	echo 'Terminating...' >&2
	exit 1
fi

# Note the quotes around "$TEMP": they are essential!
eval set -- "$TEMP"
unset TEMP

while true; do
	case "$1" in

		'-d'|'--directory')
			echo "Option -d, --directory; argument '$2'"
			XDG_STORAGE_DIR="$2"
			shift 2
			continue
		;;

		'-b'|'--backup')
			echo "Option -b --backup; argument '$2'"
			backup="$2"
			shift 2
			continue
		;;

		'--')
			shift
			break
		;;

		*)
			echo 'Internal error!' >&2
			exit 1
		;;
	esac
done

echo 'Remaining arguments:'
for arg; do
	echo "--> '$arg'"
done

# Backup-Verz.
backup="${backup:-$HOME/Backup/}"
mkdir -p "$backup" && [ -w "$backup" ]

all=$(mktemp)
dup=$(mktemp)
sum=$(mktemp)
trap "rm -f -- '$all' '$dup' '$sum'" 0 1 2 3 15

cd "$XDG_STORAGE_DIR"

# Hashes aller Dat. erzeugen; Leere auslassen
find -type f ! -empty \
	| xargs -d'\n' -P$threads_num -I{} md5sum "{}" \
	| tee $all

# doppelte Dat. auflisten
cut -b 1-32 $all | sort | uniq --repeated | while read i; do
	grep "^$i" $all | cut -b 34- | while read j; do
		echo "$i $j" >> $dup
	done
	echo >> $dup # NEW DATASET
done
 
# doppelte Dat. verschieben/löschen
while read i; do
	if [ $(echo "$i" | cut -b 1-32) != "" ]; then # "" is a NEW DATASET see above
		echo "$i" | cut -b 34- >>$sum
	else
		while read uniq; do
			[ ! -e "$uniq" ] && continue
			while read file; do
				[ ! -e "$file" -o "$file" = "$uniq" ] && continue
				# Wenn die Dateien (noch) existieren und die Pfade 
				# unterschiedlich sind, byte-genaue Kopien verschieben/löschen
				cmp --quiet "$uniq" "$file" && mv -v --backup=numbered --target-directory="$backup" "$file"
			done <$sum
		done <$sum
		echo >$sum
	fi
done <$dup

